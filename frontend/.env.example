# Sign-in functions (frontend/api). On Vercel these are set in Project Settings > Environment Variables.
# For local use: copy to .env, fill in, then `npm run api` (this file's values are read by dev-api.mjs).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Where the web app is served. Local: http://localhost:5173  Production: https://slate.rithwikbandi.tech
APP_ORIGIN=http://localhost:5173
# Any long random string (32+ characters). Encrypts the session cookie.
COOKIE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional: enables the read-only YouTube stats on published videos.
YT_API_KEY=
PORT=8787
