# Auth server (server/index.js). Copy to .env for local use; set the same keys in Render.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Where the web app is served. Local: http://localhost:5173  Production: https://your-app.vercel.app
APP_ORIGIN=http://localhost:5173
# Any long random string (32+ characters). Encrypts the session cookie.
COOKIE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional: enables the read-only YouTube stats on published videos.
YT_API_KEY=
PORT=8787
